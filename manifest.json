{
  "manifest_version": 3,
  "name": "User Activity Monitor & Analyzer",
  "version": "1.0.0",
  "description": "Monitor user network activity, keyboard and mouse operations for QA analysis",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-workers.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content.js",
        "content/keyboard-monitor.js",
        "content/mouse-monitor.js",
        "content/activity-aggregator.js",
        "content/privacy-manager.js",
        "content/activity-replayer.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Activity Monitor & Analyzer"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [{
    "resources": ["content/network-monitor-bridge.js"],
    "matches": ["<all_urls>"]
  }]
}